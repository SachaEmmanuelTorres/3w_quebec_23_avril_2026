FROM alpine:latest

# Installation d'un environnement ultra-léger (Openbox + TigerVNC + NoVNC)
RUN apk add --no-cache \
    openbox \
    xfce4-terminal \
    tigervnc \
    novnc \
    bash \
    python3 \
    py3-pip \
    git \
    && rm -rf /var/cache/apk/*

WORKDIR /root

# Configuration VNC
RUN mkdir -p .vnc && \
    echo "password" | vncpasswd -f > .vnc/passwd && \
    chmod 600 .vnc/passwd

# Script de lancement léger
RUN echo -e '#!/bin/bash\nopenbox-session &\n/usr/bin/tigervncserver :1 -geometry 1280x800 -xstartup /usr/bin/openbox\n/usr/share/novnc/utils/novnc_proxy --vnc localhost:5901 --listen 6080' > start.sh && \
    chmod +x start.sh

EXPOSE 6080

CMD ["./start.sh"]
